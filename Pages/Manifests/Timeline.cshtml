@page
@model IIIF.POC.EventSourcedManifestStore.Pages.Manifests.TimelineModel
@{
    ViewData["Title"] = "Event timeline";
}

<section class="page-heading">
    <div>
        <span class="eyebrow">APPEND-ONLY STREAM</span>
        <h1>Manifest event timeline</h1>
        <p class="wrap"><code>@Model.ManifestId</code></p>
    </div>

    <a asp-page="Details"
       asp-route-manifestId="@Model.ManifestId"
       class="button secondary">Current aggregate</a>
</section>

<section class="card">
    <div class="section-heading">
        <div>
            <h2>@Model.Events.Count event(s)</h2>
            <p>
                Each row is one immutable domain event. Use “View state” to replay the
                stream only through that revision.
            </p>
        </div>
    </div>

    <div class="event-stack">
        @foreach (var item in Model.Events.OrderByDescending(x => x.Revision))
        {
            <article class="event-card">
                <header>
                    <div>
                        <span class="badge">revision @item.Revision</span>
                        <h3>@item.EventType</h3>
                    </div>

                    <a asp-page="Details"
                       asp-route-manifestId="@Model.ManifestId"
                       asp-route-revision="@item.Revision"
                       class="button secondary">View state</a>
                </header>

                <dl>
                    <dt>Occurred UTC</dt>
                    <dd>@item.OccurredAtUtc.ToString("u")</dd>

                    <dt>Event ID</dt>
                    <dd><code>@item.EventId</code></dd>
                </dl>

                @if (item.Audit is not null)
                {
                    <div class="audit-block">
                        <h4>SDK ChangeSet audit</h4>
                        <p>
                            ChangeSet <code>@item.Audit.ChangeSetId</code>,
                            created @item.Audit.CreatedAtUtc.ToString("u")
                        </p>

                        <div class="table-card embedded">
                            <table>
                                <thead>
                                <tr>
                                    <th>Path</th>
                                    <th>Kind</th>
                                    <th>Original</th>
                                    <th>Current</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var change in item.Audit.Changes)
                                {
                                    <tr>
                                        <td><code>@change.Path</code></td>
                                        <td>@change.Kind</td>
                                        <td class="json-cell"><code>@change.OriginalValueJson</code></td>
                                        <td class="json-cell"><code>@change.CurrentValueJson</code></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <details>
                    <summary>Stored event payload</summary>
                    <pre>@item.RawJson</pre>
                </details>
            </article>
        }
    </div>
</section>
